{
  "manifest_version": 3,
  "name": "AI head-up dispaly · 本地 AI 额度桥接",
  "version": "0.8.1",
  "minimum_chrome_version": "116",
  "description": "从 OpenAI API、Claude、Grok、Gemini 的官方页面读取额度，仅发送到本机 AI head-up dispaly。",
  "permissions": ["storage", "alarms"],
  "host_permissions": ["https://claude.ai/*", "https://platform.claude.com/*", "https://platform.openai.com/*", "https://grok.com/*", "https://gemini.google.com/*", "http://127.0.0.1:4317/*"],
  "background": { "service_worker": "worker.js" },
  "action": { "default_popup": "popup.html", "default_title": "AI head-up dispaly 自动额度" },
  "content_scripts": [{
    "matches": ["http://127.0.0.1:4317/*"],
    "js": ["bridge.js"],
    "run_at": "document_end"
  }, {
    "matches": ["https://claude.ai/*", "https://grok.com/*", "https://gemini.google.com/usage*"],
    "js": ["parser.js", "content.js"],
    "run_at": "document_start"
  }, {
    "matches": ["https://platform.claude.com/*"],
    "js": ["claude-api.js", "content.js"],
    "run_at": "document_start"
  }, {
    "matches": ["https://platform.openai.com/*"],
    "js": ["openai-api.js", "content.js"],
    "run_at": "document_start"
  }]
}
